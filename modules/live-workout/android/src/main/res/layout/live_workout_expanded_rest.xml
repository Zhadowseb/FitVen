<?xml version="1.0" encoding="utf-8"?>
<!-- 1f expanded: 1e's skeleton, with the rest in place of the current
     exercise's row - "PAUSE" and "af 3:00", then the countdown (a Chronometer,
     so it counts by itself) and the bar of what is left. The next exercise's
     row stays. Buttons: −15 s · Spring over · +15 s. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <include layout="@layout/live_workout_part_header" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/live_workout_rest_label"
        style="@style/LiveWorkout.Text.Heavy.RowLabel.Rest"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

      <TextView
        android:id="@+id/live_workout_rest_of"
        style="@style/LiveWorkout.Text.Heavy.RowLabel.RestOf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="26dp"
      android:layout_marginTop="5dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <Chronometer
        android:id="@+id/live_workout_rest_clock"
        style="@style/LiveWorkout.Text.Heavy.RestClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

      <ProgressBar
        android:id="@+id/live_workout_rest_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:indeterminate="false"
        android:max="1000"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progressDrawable="@drawable/live_workout_rest_bar" />
    </LinearLayout>
  </LinearLayout>

  <include layout="@layout/live_workout_part_next_row" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginTop="14dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/live_workout_minus"
      style="@style/LiveWorkout.Button"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/live_workout_button_secondary">

      <TextView
        android:id="@+id/live_workout_minus_text"
        style="@style/LiveWorkout.Text.Heavy.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/live_workout_skip"
      style="@style/LiveWorkout.Button"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="8dp"
      android:layout_marginEnd="8dp"
      android:layout_weight="1.4"
      android:background="@drawable/live_workout_button_primary">

      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/live_workout_ic_skip"
        android:tint="@color/live_workout_ink" />

      <TextView
        android:id="@+id/live_workout_skip_text"
        style="@style/LiveWorkout.Text.Heavy.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/live_workout_plus"
      style="@style/LiveWorkout.Button"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/live_workout_button_secondary">

      <TextView
        android:id="@+id/live_workout_plus_text"
        style="@style/LiveWorkout.Text.Heavy.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
