<?xml version="1.0" encoding="utf-8"?>
<!-- The next exercise's row, in 1e and 1f: "Næste: {name}" and its sets, all
     still to do. Hidden when there is no next exercise. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/live_workout_row_next"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="10dp"
  android:orientation="vertical">

  <TextView
    android:id="@+id/live_workout_row_next_label"
    style="@style/LiveWorkout.Text.Heavy.RowLabel.Next"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />

  <LinearLayout
    android:id="@+id/live_workout_chips_next"
    android:layout_width="match_parent"
    android:layout_height="26dp"
    android:layout_marginTop="5dp"
    android:divider="@drawable/live_workout_chip_gap"
    android:orientation="horizontal"
    android:showDividers="middle" />
</LinearLayout>
