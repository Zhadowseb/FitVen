<?xml version="1.0" encoding="utf-8"?>
<!-- The card's colours on a light notification shade (e.g. One UI in light
     mode): dark text, and the tints laid over black. values-night holds the
     dark shade the design is drawn for. The orange and the ink on it are the
     same in both, and so are the weight buttons' fills and edges; their text
     is darker here and lighter there, so it reads at 4.5:1 or more. -->
<resources>
  <color name="live_workout_orange">#F7742E</color>
  <color name="live_workout_ink">#14100C</color>

  <color name="live_workout_text_primary">#14161C</color>
  <color name="live_workout_text_secondary">#5A5F6B</color>
  <!-- The current exercise's row label, between the two. -->
  <color name="live_workout_text_label">#3A3E48</color>

  <!-- black @ 0.14: the rings' and the rest bar's track -->
  <color name="live_workout_track">#24000000</color>
  <!-- black @ 0.08: −15 s, +15 s -->
  <color name="live_workout_button">#14000000</color>
  <!-- black @ 0.06: a set still to do -->
  <color name="live_workout_chip_todo">#0F000000</color>
  <!-- black @ 0.12: the touch ripple -->
  <color name="live_workout_ripple">#1F000000</color>

  <!-- orange @ 0.12: a done set; orange @ 0.16: the set being done -->
  <color name="live_workout_chip_done">#1FF7742E</color>
  <color name="live_workout_chip_now">#29F7742E</color>
  <!-- black @ 0.16 on the orange buttons -->
  <color name="live_workout_ripple_on_orange">#29000000</color>
  <!-- orange @ 0.34: what is left of the rest, behind the collapsed card -->
  <color name="live_workout_rest_fill">#57F7742E</color>

  <!-- The weight buttons (1e): −step on danger #F0605A, +step on secondary
       #4ED39A, each its colour @ 0.16 with a 1 dp edge @ 0.45, the same on
       both shades.

       Their text ("−", "2,5 kg": 17/700 and 13/800, so not large text) needs
       4.5:1, and the design's own red and green give 2.4-3.2:1 and 1.5-1.9:1
       on a light shade. So the text here is the same hue, darker. Against the
       button's fill laid over the shade - white, #F7F7F7 (One UI), #F3EDF7
       (Material 3 surface), #EEF0F3 - and against the bare shade:
         red   #BA1811  4.80-6.51:1
         green #1C6F4B  4.89-6.13:1 -->
  <color name="live_workout_weight_minus_text">#BA1811</color>
  <color name="live_workout_weight_minus_fill">#29F0605A</color>
  <color name="live_workout_weight_minus_edge">#73F0605A</color>
  <color name="live_workout_weight_plus_text">#1C6F4B</color>
  <color name="live_workout_weight_plus_fill">#294ED39A</color>
  <color name="live_workout_weight_plus_edge">#734ED39A</color>
</resources>
