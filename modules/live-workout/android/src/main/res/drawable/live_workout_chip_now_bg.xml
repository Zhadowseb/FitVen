<?xml version="1.0" encoding="utf-8"?>
<!-- A shape's stroke is drawn inside its bounds, so this is the design's
     1.5 dp inner border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle">
  <corners android:radius="8dp" />
  <solid android:color="@color/live_workout_chip_now" />
  <stroke
    android:width="1.5dp"
    android:color="@color/live_workout_orange" />
</shape>
