{
  "expo": {
    "name": "FitVen",
    "slug": "programapp",
    "version": "2.17.5",
    "scheme": "fitven",
    "orientation": "default",
    "icon": "./assets/icon_v1.0.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.fitven.app",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FitVen uses your location to match a workout to the fitness centre you are in, and to draw the route and measure the distance of a walk while it is running.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.fitven.app"
        ]
      },
      "buildNumber": "18"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "versionCode": 18,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBzhic_QC-cV-3qKnqR1a87D8D8jMX4xI4"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_v1.0.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.programapp",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon_v1.0.png"
    },
    "plugins": [
      "./plugins/withDevAppVariant",
      "./plugins/withoutLocationForegroundService",
      "expo-sqlite",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "FitVen uses Bluetooth to connect to your heart rate monitor and show live heart rate during workouts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff7a2a",
          "defaultChannel": "activity"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitVen uses your location to match a workout to the fitness centre you are in, and to draw the route and measure the distance of a walk while it is running.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "FitVen uses your motion and fitness data to count the steps of a walk and show your cadence."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitVen uses your photos so you can upload a profile picture or a video of an exercise.",
          "cameraPermission": "FitVen uses the camera so you can record a video of an exercise.",
          "microphonePermission": "FitVen uses the microphone when you record a video of an exercise."
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "spotifyClientId": "42e6c32ad3b84a8ebe667da6bdeb2fb0",
      "eas": {
        "projectId": "95d3eed5-2581-4091-8c7c-56bed74353ec"
      }
    }
  }
}
