{
  "expo": {
    "name": "FitVen",
    "slug": "programapp",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon_v1.0.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.fitven.app",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to track workout distance.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "16"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "versionCode": 16,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBzhic_QC-cV-3qKnqR1a87D8D8jMX4xI4"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_v1.0.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.programapp",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon_v1.0.png"
    },
    "plugins": [
      "./plugins/withDevAppVariant",
      "expo-sqlite",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "FitVen uses Bluetooth to connect to your heart rate monitor and show live heart rate during workouts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff7a2a",
          "defaultChannel": "activity"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitVen uses your precise location to track run distance.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitVen uses your photos so you can upload a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "95d3eed5-2581-4091-8c7c-56bed74353ec"
      }
    }
  }
}
