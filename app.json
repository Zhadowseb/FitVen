{
  "expo": {
    "name": "FitVen",
    "slug": "programapp",
    "version": "2.9.0",
    "scheme": "fitven",
    "orientation": "default",
    "icon": "./assets/icon_v1.0.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.fitven.app",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to track workout distance and to match a workout to the fitness centre you are in.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "18"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "versionCode": 18,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBzhic_QC-cV-3qKnqR1a87D8D8jMX4xI4"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_v1.0.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.programapp",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon_v1.0.png"
    },
    "plugins": [
      "./plugins/withDevAppVariant",
      "expo-sqlite",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "FitVen uses Bluetooth to connect to your heart rate monitor and show live heart rate during workouts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff7a2a",
          "defaultChannel": "activity"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitVen uses your precise location to track run distance and to match a workout to the fitness centre you are in.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitVen uses your photos so you can upload a profile picture or a video of a lift.",
          "cameraPermission": "FitVen uses the camera so you can record a video of a lift for verification.",
          "microphonePermission": "FitVen uses the microphone when you record a video of a lift."
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "95d3eed5-2581-4091-8c7c-56bed74353ec"
      }
    }
  }
}
